asset.require(openspace.absPath("${USER_ASSETS}/cosmos2/atlas.asset"))
local project = openspace.absPath("${COSMOS2}")
local kernels = {project .. "/output/solar-integration-staging/jupiter-center-jup365-from-jup348.bsp",project .. "/output/is6-planet-catalog-data-20261110a/center-499.bsp",project .. "/output/is6-planet-catalog-data-20261110a/center-799.bsp",project .. "/output/is6-planet-catalog-data-20261110a/center-899.bsp"}
local nodes = {{Identifier="Mercury",Transform={Translation={Type="SpiceTranslation",Target="199",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_MERCURY",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={2440530,2440530,2438260},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-planet-visuals-20261111a/Mercury_MESSENGER_MDIS_Basemap_BDR_Mosaic_Global_32ppd.jpg",Enabled=true}}}},GUI={Name="Mercúrio",Path="/Cosmos2"}},{Identifier="Venus",Transform={Translation={Type="SpiceTranslation",Target="299",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_VENUS",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={6051800,6051800,6051800},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-planet-visuals-20261111a/venus_clouds.jpg",Enabled=true}}}},GUI={Name="Vênus",Path="/Cosmos2"}},{Identifier="Mars",Transform={Translation={Type="SpiceTranslation",Target="499",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_MARS",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={3396190,3396190,3376200},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-planet-visuals-20261111a/mars.png",Enabled=true}}}},GUI={Name="Marte",Path="/Cosmos2"}},{Identifier="Jupiter",Transform={Translation={Type="SpiceTranslation",Target="599",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_JUPITER",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={71492000,71492000,66854000},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-planet-visuals-20261111a/jupiter_os.tif",Enabled=true}}}},GUI={Name="Júpiter",Path="/Cosmos2"}},{Identifier="Uranus",Transform={Translation={Type="SpiceTranslation",Target="799",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_URANUS",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={25559000,25559000,24973000},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-planet-visuals-20261111a/uranus.jpg",Enabled=true}}}},GUI={Name="Urano",Path="/Cosmos2"}},{Identifier="Neptune",Transform={Translation={Type="SpiceTranslation",Target="899",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_NEPTUNE",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={24764000,24764000,24341000},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-planet-visuals-20261111a/neptune.jpg",Enabled=true}}}},GUI={Name="Netuno",Path="/Cosmos2"}}}
asset.onInitialize(function()
  openspace.spice.loadKernel(kernels)
  for _, node in ipairs(nodes) do openspace.addSceneGraphNode(node) end
end)
asset.onDeinitialize(function()
  for index = #nodes, 1, -1 do openspace.removeSceneGraphNode(nodes[index].Identifier) end
  openspace.spice.unloadKernel(kernels)
end)
asset.meta = {Name="Cosmos2 eight-planet scene",Author="Cosmos2 / JPL / OpenSpace",Description="Physical centers, fixed visual maps and general IAU rotations."}
