asset.require(openspace.absPath("${COSMOS2}/output/is6-planet-navigation-staging/planet_scene.asset"))
local project = openspace.absPath("${COSMOS2}")
local kernels = {project .. "/output/is6-principal-moons-data-20261111b/moon-501.bsp",project .. "/output/is6-principal-moons-data-20261111b/moon-502.bsp",project .. "/output/is6-principal-moons-data-20261111b/moon-503.bsp",project .. "/output/is6-principal-moons-data-20261111b/moon-504.bsp",project .. "/output/is6-principal-moons-data-20261111b/moon-602.bsp",project .. "/output/is6-principal-moons-data-20261111b/moon-606.bsp"}
local nodes = {{Identifier="Io",Transform={Translation={Type="SpiceTranslation",Target="501",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_IO",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={1829400,1819400,1815700},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-principal-moons-visuals-20261111a/io.jpg",Enabled=true}}}},GUI={Name="Io",Path="/Cosmos2/Luas"}},{Identifier="Europa",Transform={Translation={Type="SpiceTranslation",Target="502",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_EUROPA",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={1562600,1560300,1559500},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-principal-moons-visuals-20261111a/europa_os.tif",Enabled=true}}}},GUI={Name="Europa",Path="/Cosmos2/Luas"}},{Identifier="Ganymede",Transform={Translation={Type="SpiceTranslation",Target="503",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_GANYMEDE",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={2631200,2631200,2631200},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-principal-moons-visuals-20261111a/ganymede.jpg",Enabled=true}}}},GUI={Name="Ganimedes",Path="/Cosmos2/Luas"}},{Identifier="Callisto",Transform={Translation={Type="SpiceTranslation",Target="504",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_CALLISTO",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={2410300,2410300,2410300},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-principal-moons-visuals-20261111a/callisto_os.tif",Enabled=true}}}},GUI={Name="Calisto",Path="/Cosmos2/Luas"}},{Identifier="Enceladus",Transform={Translation={Type="SpiceTranslation",Target="602",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_ENCELADUS",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={256600.00000000003,251400,248300},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-principal-moons-visuals-20261111a/enceladus.jpg",Enabled=true}}}},GUI={Name="Encélado",Path="/Cosmos2/Luas"}},{Identifier="Titan",Transform={Translation={Type="SpiceTranslation",Target="606",Observer="0",Frame="GALACTIC"},Rotation={Type="SpiceRotation",SourceFrame="IAU_TITAN",DestinationFrame="GALACTIC"}},Renderable={Type="RenderableGlobe",Radii={2575150,2574780,2574470},PerformShading=true,LightSourceNode="Sun",Layers={ColorLayers={{Identifier="ReferenceMap",Name="Mapa visual OpenSpace",FilePath=project .. "/output/is6-principal-moons-visuals-20261111a/Titan_ISS_P19658_Mosaic_Global_4km_os.tif",Enabled=true}}}},GUI={Name="Titã",Path="/Cosmos2/Luas"}}}
asset.onInitialize(function() openspace.spice.loadKernel(kernels);for _,node in ipairs(nodes) do openspace.addSceneGraphNode(node) end end)
asset.onDeinitialize(function() for index=#nodes,1,-1 do openspace.removeSceneGraphNode(nodes[index].Identifier) end;openspace.spice.unloadKernel(kernels) end)
asset.meta={Name="Cosmos2 principal moons",Author="Cosmos2 / JPL / OpenSpace",Description="Geometric moon centers, original fixed maps and general IAU rotations."}
