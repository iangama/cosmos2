+/** Starts bounded opt-in CPU wall-time stage tracing; off by default. */
+[[codegen::luawrap]] void cosmos2BeginStageTrace() {
+    openspace::cosmos2trace::recorder.begin();
+}
+
+/** Returns nested stage wall times and intervals above50ms; not GPU timings. */
+[[codegen::luawrap]] ghoul::Dictionary cosmos2EndStageTrace() {
+    using namespace openspace::cosmos2trace;
+    recorder.active = false;
+    ghoul::Dictionary stats, samples, result;
+    for (size_t i = 0; i < recorder.stats.size(); ++i) {
+        const Stat& s = recorder.stats[i];
+        if (s.count == 0) { continue; }
+        ghoul::Dictionary value;
+        value.setValue("name", std::string(s.name));
+        value.setValue("count", static_cast<double>(s.count));
+        value.setValue("total_s", s.total); value.setValue("maximum_s", s.maximum);
+        stats.setValue(std::to_string(i), value);
+    }
+    for (size_t i = 0; i < recorder.samples.size(); ++i) {
+        const Sample& s = recorder.samples[i]; ghoul::Dictionary value;
+        value.setValue("slot", s.slot); value.setValue("begin_offset_s", s.begin);
+        value.setValue("duration_s", s.duration);
+        samples.setValue(std::to_string(i + 1), value);
+    }
+    result.setValue("stats", stats); result.setValue("slow_intervals", samples);
+    result.setValue("truncated", recorder.truncated);
+    result.setValue("scope", std::string("Opt-in CPU wall times; nested regions overlap; inter-frame gap includes SGCT/swap/presentation; not GPU execution timing"));
+    return result;
+}
