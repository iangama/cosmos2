--- /dev/null
+++ b/include/openspace/engine/cosmos2stagetrace.h
@@ -0,0 +1,56 @@
+// Cosmos2 bounded opt-in wall-time diagnostics. No scientific state is touched.
+#ifndef COSMOS2_STAGE_TRACE_H
+#define COSMOS2_STAGE_TRACE_H
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <vector>
+namespace openspace::cosmos2trace {
+using Clock = std::chrono::steady_clock;
+struct Stat { const char* name = ""; std::uint64_t count = 0; double total = 0.; double maximum = 0.; };
+struct Sample { int slot; double begin; double duration; };
+struct Recorder {
+    bool active = false; bool truncated = false; std::uint64_t generation = 0;
+    Clock::time_point start; Clock::time_point lastFrameEnd;
+    bool hasFrameEnd = false;
+    std::array<Stat, 128> stats{}; std::vector<Sample> samples;
+    void begin() {
+        active = false; ++generation; stats = {}; samples.clear(); samples.reserve(512);
+        truncated = false; hasFrameEnd = false; start = Clock::now(); active = true;
+    }
+    void add(int slot, const char* name, Clock::time_point began, Clock::time_point ended) {
+        const double duration = std::chrono::duration<double>(ended - began).count();
+        Stat& s = stats.at(slot); s.name = name; ++s.count; s.total += duration;
+        if (duration > s.maximum) { s.maximum = duration; }
+        if (duration >= .05) {
+            if (samples.size() < 512) {
+                samples.push_back({slot, std::chrono::duration<double>(began - start).count(), duration});
+            }
+            else { truncated = true; }
+        }
+    }
+};
+inline Recorder recorder;
+class Scope {
+public:
+    Scope(int slot, const char* name, bool closesFrame = false)
+        : _slot(slot), _name(name), _enabled(recorder.active),
+          _generation(recorder.generation), _closesFrame(closesFrame)
+    { if (_enabled) { _start = Clock::now(); } }
+    ~Scope() {
+        if (_enabled && recorder.active && _generation == recorder.generation) {
+            const auto end = Clock::now(); recorder.add(_slot, _name, _start, end);
+            if (_closesFrame) { recorder.lastFrameEnd = end; recorder.hasFrameEnd = true; }
+        }
+    }
+private:
+    int _slot; const char* _name; bool _enabled; std::uint64_t _generation;
+    bool _closesFrame; Clock::time_point _start;
+};
+inline void frameStart() {
+    if (recorder.active && recorder.hasFrameEnd) {
+        recorder.add(0, "outside_engine_between_frames", recorder.lastFrameEnd, Clock::now());
+    }
+}
+}
+#endif
