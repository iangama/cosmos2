+void RenderablePointCloud::updateConfirmedCloud() {
+    try {
+        std::error_code ec;
+        const auto stamp = std::filesystem::last_write_time(_cloudFile, ec);
+        if (ec || (_cloudLastWrite && *_cloudLastWrite == stamp)) { return; }
+        const auto size = std::filesystem::file_size(_cloudFile, ec);
+        if (ec) { return; }
+        if (size < 13 || size > 12 + 32768 + 10000 * 24) {
+            _cloudLastWrite = stamp;
+            throw std::runtime_error("Packet size outside bounded cloud contract");
+        }
+        std::ifstream file(_cloudFile, std::ios::binary);
+        if (!file) { return; } // Atomic replacement can briefly deny a Windows reader.
+        std::vector<char> bytes(static_cast<size_t>(size));
+        file.read(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+        if (!file) { return; }
+        _cloudLastWrite = stamp;
+        if (std::memcmp(bytes.data(), "C2CLD002", 8) != 0) {
+            throw std::runtime_error("Invalid cloud magic");
+        }
+        std::uint32_t n = 0;
+        std::memcpy(&n, bytes.data() + 8, 4);
+        if (n == 0 || n > 32768 || 12 + n > bytes.size()) {
+            throw std::runtime_error("Invalid cloud header size");
+        }
+        const auto m = nlohmann::json::parse(bytes.data() + 12, bytes.data() + 12 + n);
+        const std::vector<std::string> keys = { "schema", "model", "system_id", "edit_token",
+            "cloud_id", "source_id", "sequence", "time_model", "time_s", "time_unit_s",
+            "length_unit_m", "frame", "count", "positions", "payload_sha256", "payload_crc32" };
+        if (!m.is_object() || m.size() != keys.size() ||
+            !std::all_of(keys.begin(), keys.end(), [&m](const std::string& k) { return m.contains(k); }))
+        { throw std::runtime_error("Invalid cloud metadata keys"); }
+        if (!m.at("schema").is_number_unsigned() || m.at("schema") != 2 ||
+            m.at("model") != "massless_central_ias15_v1" || m.at("system_id") != _cloudSystem ||
+            m.at("edit_token") != _cloudEdit || m.at("cloud_id") != _cloudId ||
+            m.at("source_id") != _cloudSource || m.at("frame") != _cloudFrame ||
+            !m.at("count").is_number_unsigned() || m.at("count") != _cloudCount ||
+            m.at("positions") != "SI_m_float64_little_endian_xyz" ||
+            !m.at("sequence").is_number_unsigned() || m.at("sequence").get<std::uint64_t>() >= (1ULL << 63))
+        { throw std::runtime_error("Stale or incompatible cloud population binding"); }
+        const auto sequence = m.at("sequence").get<std::int64_t>();
+        if (sequence <= _cloudSequence) { throw std::runtime_error("Cloud sequence did not advance"); }
+        for (const auto* k : { "time_model", "time_s", "time_unit_s", "length_unit_m" }) {
+            if (!m.at(k).is_number() || !std::isfinite(m.at(k).get<double>()) || m.at(k).get<double>() < 0.0) {
+                throw std::runtime_error("Nonfinite or negative cloud time/scale");
+            }
+        }
+        const double time = m.at("time_model").get<double>();
+        if (time < _cloudTime || m.at("time_unit_s").get<double>() != _cloudTimeUnit ||
+            m.at("length_unit_m").get<double>() != 1e9 ||
+            m.at("time_s").get<double>() != time * _cloudTimeUnit)
+        { throw std::runtime_error("Cloud clock or SI scale mismatch"); }
+        const char* payload = bytes.data() + 12 + n;
+        const size_t payloadSize = bytes.size() - 12 - n;
+        if (payloadSize != static_cast<size_t>(_cloudCount) * 24 ||
+            !m.at("payload_crc32").is_number_unsigned() ||
+            m.at("payload_crc32").get<std::uint64_t>() != ghoul::hashCRC32(payload, static_cast<unsigned int>(payloadSize)))
+        { throw std::runtime_error("Invalid cloud payload size or CRC32"); }
+        const std::string sha = m.at("payload_sha256").get<std::string>();
+        if (sha.size() != 64 || !std::all_of(sha.begin(), sha.end(), [](char x) {
+            return (x >= '0' && x <= '9') || (x >= 'a' && x <= 'f'); }))
+        { throw std::runtime_error("Invalid cloud source SHA256 declaration"); }
+        std::vector<dataloader::Dataset::Entry> entries(_cloudCount);
+        double maximumError = 0.0;
+        for (unsigned int i = 0; i < _cloudCount; ++i) {
+            glm::dvec3 position;
+            std::memcpy(&position[0], payload + static_cast<size_t>(i) * 24, 24);
+            if (!std::isfinite(position.x) || !std::isfinite(position.y) ||
+                !std::isfinite(position.z) || glm::length(position) > 1e17)
+            { throw std::runtime_error("Cloud point outside finite SI domain"); }
+            entries[i].position = glm::vec3(position);
+            maximumError = std::max(maximumError, glm::length(glm::dvec3(entries[i].position) - position));
+        }
+        // Validate the whole packet before touching the aggregate GPU buffer.
+        _dataset.entries = std::move(entries);
+        _hasDataFile = true; _unit = DistanceUnit::Meter;
+        _nDataPoints = _cloudCount; _dataIsDirty = true;
+        updateBufferData();
+        _cloudSequence = sequence; _cloudTime = time;
+        _cloudStatus = nlohmann::json({ { "state", "accepted" }, { "metadata", m },
+            { "maximum_gpu_position_quantization_m", maximumError },
+            { "native_integrity_check", "CRC32; SHA256 independently verified by Python" },
+            { "gpu_buffer_uploaded", true } }).dump();
+    }
+    catch (const std::exception& e) {
+        _cloudStatus = nlohmann::json({ { "state", "rejected" }, { "error", e.what() },
+            { "last_accepted_sequence", _cloudSequence }, { "last_accepted_time_model", _cloudTime },
+            { "previous_buffer_preserved", true } }).dump();
+    }
+}
