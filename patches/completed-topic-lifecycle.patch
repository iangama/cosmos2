+void Connection::removeFinishedTopics() {
+    // Called on the engine thread at the next preSync, after asynchronous script
+    // callbacks have returned. Never delete a topic from inside its callback.
+    for (auto it = _topics.begin(); it != _topics.end();) {
+        if (it->second->isDone()) {
+            it = _topics.erase(it);
+        }
+        else {
+            ++it;
+        }
+    }
+}
