--- /dev/null
+++ b/include/openspace/util/cosmos2offline.h
@@ -0,0 +1,28 @@
+// Cosmos2 local fork: optional loopback-only HTTP policy for offline acceptance.
+#pragma once
+#include <curl/curl.h>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+
+namespace openspace::cosmos2 {
+inline bool offline() {
+    const char* flag = std::getenv("COSMOS2_OFFLINE");
+    return flag && std::string_view(flag) == "1";
+}
+inline bool networkAllowed(const std::string& url) {
+    if (!offline()) { return true; }
+    CURLU* parsed = curl_url();
+    char* host = nullptr;
+    bool local = false;
+    if (parsed && curl_url_set(parsed, CURLUPART_URL, url.c_str(), 0) == CURLUE_OK &&
+        curl_url_get(parsed, CURLUPART_HOST, &host, 0) == CURLUE_OK)
+    {
+        const std::string_view hostname(host);
+        local = hostname == "127.0.0.1" || hostname == "localhost" || hostname == "[::1]";
+    }
+    curl_free(host);
+    curl_url_cleanup(parsed);
+    return local;
+}
+} // namespace openspace::cosmos2
