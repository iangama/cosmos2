diff --git a/include/ghoul/font/utf8.h b/include/ghoul/font/utf8.h
new file mode 100644
--- /dev/null
+++ b/include/ghoul/font/utf8.h
@@ -0,0 +1,52 @@
+// Cosmos2 local adaptation: decode UTF-8 before passing glyph IDs to FreeType.
+#pragma once
+#include <cstdint>
+#include <limits>
+#include <string_view>
+#include <vector>
+
+namespace ghoul::fontrendering {
+inline std::vector<wchar_t> decodeFontUtf8(std::string_view text) {
+    std::vector<wchar_t> result;
+    result.reserve(text.size());
+    for (size_t i = 0; i < text.size();) {
+        const auto lead = static_cast<unsigned char>(text[i]);
+        uint32_t value = lead;
+        size_t count = 1;
+        uint32_t minimum = 0;
+        if (lead >= 0xC2 && lead <= 0xDF) {
+            count = 2; value = lead & 0x1F; minimum = 0x80;
+        }
+        else if (lead >= 0xE0 && lead <= 0xEF) {
+            count = 3; value = lead & 0x0F; minimum = 0x800;
+        }
+        else if (lead >= 0xF0 && lead <= 0xF4) {
+            count = 4; value = lead & 0x07; minimum = 0x10000;
+        }
+        else if (lead >= 0x80) {
+            result.push_back(static_cast<wchar_t>(0xFFFD)); ++i; continue;
+        }
+        bool valid = i + count <= text.size();
+        for (size_t j = 1; valid && j < count; j++) {
+            const auto continuation = static_cast<unsigned char>(text[i + j]);
+            valid = (continuation & 0xC0) == 0x80;
+            value = (value << 6) | (continuation & 0x3F);
+        }
+        valid = valid && value >= minimum && value <= 0x10FFFF &&
+            !(value >= 0xD800 && value <= 0xDFFF);
+        if (!valid) {
+            result.push_back(static_cast<wchar_t>(0xFFFD)); ++i; continue;
+        }
+        // The existing Windows glyph API uses 16-bit wchar_t. A non-BMP scalar
+        // occupies one replacement glyph rather than two unpaired surrogates.
+        if (value > static_cast<uint32_t>(std::numeric_limits<wchar_t>::max()) ||
+            value == 0xFFFF)
+        {
+            value = 0xFFFD;
+        }
+        result.push_back(static_cast<wchar_t>(value));
+        i += count;
+    }
+    return result;
+}
+}
