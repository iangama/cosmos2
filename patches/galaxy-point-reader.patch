diff --git a/modules/galaxy/rendering/galaxypointreader.h b/modules/galaxy/rendering/galaxypointreader.h
new file mode 100644
--- /dev/null
+++ b/modules/galaxy/rendering/galaxypointreader.h
@@ -0,0 +1,72 @@
+// Cosmos2 local adaptation: locale-independent COFF vertex parsing.
+#pragma once
+#include <array>
+#include <charconv>
+#include <cmath>
+#include <istream>
+#include <string>
+#include <string_view>
+
+namespace openspace {
+inline bool parseGalaxyPoint(std::string_view line, std::array<float, 7>& values) {
+    if (line.empty()) { return false; }
+    const char* cursor = line.data();
+    const char* end = cursor + line.size();
+    const auto whitespace = [](char c) {
+        return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+    };
+    for (float& value : values) {
+        while (cursor != end && whitespace(*cursor)) { ++cursor; }
+        if (cursor == end) { return false; }
+        if (*cursor == '+') {
+            ++cursor;
+            if (cursor != end && (*cursor == '+' || *cursor == '-')) { return false; }
+        }
+        if (cursor == end) { return false; }
+        const auto parsed = std::from_chars(cursor, end, value);
+        if (parsed.ec != std::errc() || !std::isfinite(value)) { return false; }
+        cursor = parsed.ptr;
+        if (cursor != end && !whitespace(*cursor)) { return false; }
+    }
+    while (cursor != end && whitespace(*cursor)) { ++cursor; }
+    return cursor == end;
+}
+
+template <typename Consumer>
+bool readGalaxyPointRows(std::istream& stream, size_t count, Consumer consume) {
+    // Bulk reads avoid per-character formatted stream extraction on Windows.
+    std::string block(1024 * 1024, '\0');
+    std::string partial;
+    size_t rows = 0;
+    const auto accept = [&](std::string_view line) {
+        std::array<float, 7> values;
+        if (!parseGalaxyPoint(line, values)) { return false; }
+        consume(values);
+        ++rows;
+        return true;
+    };
+    while (rows < count && stream) {
+        stream.read(block.data(), static_cast<std::streamsize>(block.size()));
+        std::string_view chunk(block.data(), static_cast<size_t>(stream.gcount()));
+        while (!chunk.empty() && rows < count) {
+            const size_t end = chunk.find('\n');
+            if (end == std::string_view::npos) {
+                partial.append(chunk);
+                break;
+            }
+            const std::string_view line = chunk.substr(0, end);
+            if (partial.empty()) {
+                if (!accept(line)) { return false; }
+            }
+            else {
+                partial.append(line);
+                if (!accept(partial)) { return false; }
+                partial.clear();
+            }
+            chunk.remove_prefix(end + 1);
+        }
+    }
+    if (rows < count && !partial.empty() && !accept(partial)) { return false; }
+    return rows == count;
+}
+}
