+// Cosmos2 bounded asynchronous script logging. The sink is called only by its worker.
+#ifndef COSMOS2_ASYNC_SCRIPT_LOG_H
+#define COSMOS2_ASYNC_SCRIPT_LOG_H
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <thread>
+namespace openspace::cosmos2log {
+class AsyncScriptLog {
+public:
+    using Sink = std::function<void(const std::optional<std::string>&)>;
+    using Error = std::function<void(const std::string&)>;
+    struct Status {
+        std::uint64_t accepted, written, dropped; std::size_t queuedBytes;
+        bool failed; double maximumWriteMs;
+    };
+    AsyncScriptLog(Sink sink, Error error, std::size_t capacity = 8 * 1024 * 1024)
+        : _sink(std::move(sink)), _error(std::move(error)), _capacity(capacity)
+    {
+        if (!_capacity) { throw std::invalid_argument("Script log capacity is zero"); }
+        _worker = std::thread([this]() { run(); });
+    }
+    ~AsyncScriptLog() {
+        { std::lock_guard lock(_mutex); _stopping = true; }
+        _ready.notify_one(); if (_worker.joinable()) { _worker.join(); }
+    }
+    bool submit(const std::string& line) {
+        std::lock_guard lock(_mutex);
+        if (_stopping || _failed || _queue.size() >= 1024 || line.size() > _capacity ||
+            _bytes > _capacity - line.size())
+        {
+            ++_dropped; _ready.notify_one(); return false;
+        }
+        _queue.push_back(line); _bytes += line.size(); ++_accepted;
+        _ready.notify_one(); return true;
+    }
+    Status status() const {
+        std::lock_guard lock(_mutex);
+        return {_accepted, _written, _dropped, _bytes, _failed, _maximumWriteMs};
+    }
+private:
+    void report(const std::string& message) noexcept {
+        try { if (_error) { _error(message); } } catch (...) {}
+    }
+    void run() noexcept {
+        std::uint64_t reportedDrops = 0;
+        try {
+            for (;;) {
+                std::string line; bool haveLine = false; std::uint64_t drops = 0;
+                {
+                    std::unique_lock lock(_mutex);
+                    _ready.wait(lock, [&]() { return _stopping || !_queue.empty() || _dropped != reportedDrops; });
+                    drops = _dropped;
+                    if (!_queue.empty()) {
+                        line = std::move(_queue.front()); _queue.pop_front();
+                        _bytes -= line.size(); haveLine = true;
+                    }
+                    else if (_stopping) { break; }
+                }
+                if (drops != reportedDrops) {
+                    report("Script log incomplete: " + std::to_string(drops) + " entries omitted by bounded queue");
+                    reportedDrops = drops;
+                }
+                if (!haveLine) { continue; }
+                const auto start = std::chrono::steady_clock::now();
+                _sink(std::move(line));
+                const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+                { std::lock_guard lock(_mutex); ++_written; if (ms > _maximumWriteMs) { _maximumWriteMs = ms; } }
+            }
+        }
+        catch (const std::exception& e) {
+            { std::lock_guard lock(_mutex); _failed = true; _dropped += _queue.size() + 1; _queue.clear(); _bytes = 0; }
+            report(std::string("Script log I/O failed: ") + e.what());
+        }
+        catch (...) {
+            { std::lock_guard lock(_mutex); _failed = true; _dropped += _queue.size() + 1; _queue.clear(); _bytes = 0; }
+            report("Script log I/O failed with an unknown error");
+        }
+        try { _sink(std::nullopt); }
+        catch (...) { { std::lock_guard lock(_mutex); _failed = true; } report("Script log close/flush failed"); }
+    }
+    Sink _sink; Error _error; const std::size_t _capacity;
+    mutable std::mutex _mutex; std::condition_variable _ready;
+    std::deque<std::string> _queue; std::size_t _bytes = 0;
+    std::uint64_t _accepted = 0, _written = 0, _dropped = 0;
+    bool _stopping = false, _failed = false; double _maximumWriteMs = 0.;
+    std::thread _worker;
+};
+inline std::unique_ptr<AsyncScriptLog> writer;
+}
+#endif
